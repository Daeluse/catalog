# Development Mode
# Set to 'true' to use mock implementations for local development
USE_MOCKS=true

# Database Configuration
# For local development with mocks, you can use any value or leave empty
# For production, use MongoDB Atlas connection string
MONGODB_URI=mongodb://localhost:27017/catalog
MONGODB_DB=catalog

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32-or-use-any-string-for-local

# Azure AD Authentication (only needed when USE_MOCKS=false)
AZURE_AD_CLIENT_ID=your-azure-ad-client-id
AZURE_AD_CLIENT_SECRET=your-azure-ad-client-secret
AZURE_AD_TENANT_ID=your-azure-ad-tenant-id

# Azure Blob Storage (only needed when USE_MOCKS=false)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
AZURE_STORAGE_ACCOUNT_NAME=your-storage-account-name
AZURE_STORAGE_CONTAINER=catalog-modules
AZURE_STORAGE_CDN_URL=https://your-cdn-endpoint.azureedge.net

# Local File Storage (when USE_MOCKS=true)
LOCAL_STORAGE_PATH=./storage

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Module Federation Catalog"
NODE_ENV=development
