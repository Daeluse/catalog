# Development Mode
# Set to 'true' to use mock implementations for local development
USE_MOCKS=true

# Database Configuration
# For local development with mocks, you can use any value or leave empty
# For production, use MongoDB Atlas connection string
MONGODB_URI=mongodb://localhost:27017/catalog
MONGODB_DB=catalog

# NextAuth Configuration
NEXTAUTH_PROVDER=azure
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=changeit

# Azure AD Authentication (only needed when USE_MOCKS=false)
AZURE_AD_CLIENT_ID=changeit
AZURE_AD_CLIENT_SECRET=changeit
AZURE_AD_TENANT_ID=changeit
AZURE_SPN_CLIENT_ID=changeit
AZURE_SPN_CLIENT_SECRET=changeit

# Azure Blob Storage (only needed when USE_MOCKS=false)
AZURE_STORAGE_ACCOUNT=changeit
AZURE_STORAGE_CONTAINER=changeit

# Local File Storage (when USE_MOCKS=true)
LOCAL_STORAGE_PATH=./storage

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Module Federation Catalog"
NODE_ENV=development
ENFORCE_CORS=false
